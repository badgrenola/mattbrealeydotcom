@tailwind base;
@tailwind components;

/* Colour palette. Light values are the original Tailwind colours; dark values follow the system setting. */
:root {
  color-scheme: light dark;

  --bg: #ffffff;
  --text: #111827;          /* gray-900 */
  --text-soft: #1f2937;     /* gray-800 */
  --icon: #000000;          /* black */
  --muted: #6b7280;         /* gray-500 */
  --muted-strong: #4b5563;  /* gray-600 */
  --pink: #db2777;          /* pink-600: headings */
  --pink-soft: #db2777;     /* pink-600: links */
  --accent: #ec4899;        /* pink-500: hover */
  --active: #ec4899;        /* pink-500: active nav, mobile social icons */
  --border: #d1d5db;        /* gray-300 */
  --rule: #e5e7eb;          /* gray-200 */
  --code: #e5e7eb;          /* gray-200 */
  --code-block: #f3f4f6;    /* gray-100 */
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0e1013;
    --text: #d9dce1;
    --text-soft: #c9cdd4;
    --icon: #d9dce1;
    --muted: #8b919c;
    --muted-strong: #a0a6b0;
    --pink: #ec4899;        /* pink-500 */
    --pink-soft: #f472b6;   /* pink-400 */
    --accent: #f472b6;      /* pink-400 */
    --active: #ec4899;      /* pink-500 */
    --border: #2a2e36;
    --rule: #2a2e36;
    --code: #1b1f26;
    --code-block: #1b1f26;
  }

  html, body {
    color: var(--text);
  }

  /* Content imagery sits a touch lower so it doesn't glare against the dark page */
  main img,
  main video {
    filter: brightness(0.92);
  }

  /* Stop the header photo merging into the background */
  .avatar {
    box-shadow: 0 0 0 2px #1d2128;
  }
}

/* Ensure page is full height */
html, body { 
  width: 100%;
  height: 100%;
  background-color: var(--bg);
}

#svelte {
  height: 100%;
}

/* Text selection */
::selection {
  @apply bg-pink-600 text-white;
}

/* Extract link styles */
a {
  cursor: pointer;
}

a.colorLink {
  @apply text-link;
}

.headerLink {  /* Not specific to links as Social component uses it too */
  @apply font-semibold text-center h-12 flex flex-col justify-center align-middle;
}

a.headerLinkActive {
  @apply text-active underline cursor-default;
}

a:hover {
  @apply text-accent underline;
}

@media (min-width: 640px) {
  a.headerLink {
      @apply mt-0 ml-2 font-normal text-sm px-2;
  }
}

/* Markdown */
/* https://raw.githubusercontent.com/iandinwoodie/github-markdown-tailwindcss/master/markdown.css */

.markdown {
  @apply text-ink leading-normal break-words;
}

.markdown a {
  @apply text-link;
}

.markdown > * {
  @apply mt-0 mb-4;
}

.markdown li + li {
  @apply mt-1;
}

.markdown li > p + p {
  @apply mt-6;
}

.markdown strong {
  @apply font-semibold;
}

.markdown h1 {
  @apply leading-tight border-b text-4xl font-semibold mb-4 mt-6 pb-2;
}

.markdown h2 {
  @apply mt-6 text-2xl text-brand font-light;
}

.markdown h2:nth-child(n+3) {
  @apply mt-12;
}

.markdown h3 {
  @apply mt-8 text-base font-light text-muted-strong;
}

.markdown h4 {
  @apply leading-none text-base font-semibold mb-4 mt-6;
}

.markdown h5 {
  @apply leading-tight text-sm font-semibold mb-4 mt-6;
}

.markdown h6 {
  @apply leading-tight text-sm font-semibold text-muted-strong mb-4 mt-6;
}

.markdown blockquote {
  @apply text-base border-l-4 border-line pl-4 pr-4 text-muted-strong;
}

.markdown code {
  @apply font-mono text-sm inline bg-code rounded px-1 py-1;
}

.markdown pre {
  @apply bg-code-block rounded p-4 break-words;
  white-space: normal;
}

.markdown pre code {
  @apply block bg-transparent p-0 rounded-none;
}

.markdown ul {
  @apply text-base pl-8 list-disc;
}

.markdown ol {
  @apply text-base pl-8 list-decimal;
}

.markdown table {
  @apply text-base border-muted-strong;
}

.markdown th {
  @apply border py-1 px-3;
}

.markdown td {
  @apply border py-1 px-3;
}

.markdown figure {
  @apply py-6 text-center;
}

.markdown figure > figcaption { 
  @apply text-xs pt-2;
}

@tailwind utilities;
