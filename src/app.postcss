@tailwind base;
@tailwind components;

/* Colour palette. Light values are the original Tailwind colours; dark values follow the system setting. */
:root {
  color-scheme: light dark;

  --bg: #ffffff;
  --text: #111827;          /* gray-900 */
  --heading: #111827;       /* article h2/h3: same as body in light */
  --text-soft: #1f2937;     /* gray-800 */
  --icon: #000000;          /* black */
  --muted: #6b7280;         /* gray-500 */
  --muted-strong: #4b5563;  /* gray-600 */
  --pink: #be185d;          /* pink-700: headings (6.0:1 on white) */
  --pink-soft: #db2777;     /* pink-600: links */
  --accent: #be185d;        /* pink-700: hover (6.0:1 on white) */
  --active: #be185d;        /* pink-700: mobile social icons */
  --border: #d1d5db;        /* gray-300 */
  --rule: #e5e7eb;          /* gray-200 */
  --code: #e5e7eb;          /* gray-200 */
  --code-block: #f3f4f6;    /* gray-100 */
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0e1013;
    --text: #d9dce1;
    --heading: #e8eaed;     /* a step brighter than body */
    --text-soft: #c9cdd4;
    --icon: #d9dce1;
    --muted: #8b919c;
    --muted-strong: #a0a6b0;
    --pink: #ec4899;        /* pink-500 */
    --pink-soft: #f472b6;   /* pink-400 */
    --accent: #f472b6;      /* pink-400 */
    --active: #ec4899;      /* pink-500 */
    --border: #2a2e36;
    --rule: #2a2e36;
    --code: #1b1f26;
    --code-block: #1b1f26;
  }

  html, body {
    color: var(--text);
  }

  /* Content imagery sits a touch lower so it doesn't glare against the dark page */
  main img:not(.avatar),
  main video {
    filter: brightness(0.92);
  }
}

/* Header photo: Apple-icon corner ratio, with an inset hairline edge */
.avatar {
  border-radius: 22.37%;
  outline: 1px solid rgb(0 0 0 / 0.1);
  outline-offset: -1px;
}

@supports (corner-shape: squircle) {
  .avatar {
    corner-shape: squircle;
  }
}

/* In dark mode the photo's edge is almost the page colour, so use a light hairline (must come after the base rule) */
@media (prefers-color-scheme: dark) {
  .avatar {
    outline-color: rgb(255 255 255 / 0.18);
  }
}

/* Trim the font's built-in space above caps so headings align on their cap-tops */
.trim-cap {
  text-box: trim-both cap alphabetic;
}

/* Ensure page is full height */
html, body { 
  width: 100%;
  height: 100%;
  background-color: var(--bg);
}

#svelte {
  height: 100%;
}

/* Text selection */
::selection {
  @apply bg-pink-600 text-white;
}

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
  border-radius: 4px;
}

/* Extract link styles */
a {
  cursor: pointer;
}

a.colorLink {
  @apply text-link;
}

/* Inline links shouldn't rely on colour alone */
.markdown a,
a.colorLink {
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 3px;
  text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
}

.markdown a:hover,
a.colorLink:hover {
  text-decoration-color: currentColor;
}

.headerLink {  /* Not specific to links as Social component uses it too */
  @apply font-semibold text-center h-12 flex flex-col justify-center align-middle;
}

a.headerLink[aria-current="page"] {
  @apply text-ink underline decoration-brand decoration-2 underline-offset-8 cursor-default;
}

a:hover {
  @apply text-accent underline;
}

@media (min-width: 640px) {
  a.headerLink {
      @apply mt-0 ml-2 font-normal text-sm px-2;
  }
}

/* Markdown */
/* https://raw.githubusercontent.com/iandinwoodie/github-markdown-tailwindcss/master/markdown.css */

.markdown {
  @apply text-ink break-words;
  font-size: 17px;
  line-height: 27px;
}

.markdown a {
  @apply text-link;
}

/* rehype-autolink-headings wraps headings in links; keep them the heading colour, underline on hover only */
.markdown :is(h1, h2, h3, h4) > a {
  color: inherit;
  text-decoration: none;
}

.markdown :is(h1, h2, h3, h4) > a:hover {
  text-decoration: underline;
  text-underline-offset: 0.2em;
}

.markdown > * {
  @apply mt-0 mb-5;
}

.markdown li + li {
  @apply mt-1;
}

.markdown li > p + p {
  @apply mt-6;
}

.markdown strong {
  @apply font-semibold;
}

.markdown h1 {
  @apply leading-tight border-b text-4xl font-semibold mb-4 mt-6 pb-2;
}

.markdown :is(h2, h3, h4) {
  @apply font-semibold;
  color: var(--heading);
  scroll-margin-top: 5rem;
}

.markdown h2 {
  @apply text-2xl sm:text-[26px] mt-14 sm:mt-16;
  margin-bottom: 14px;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.25;
}

.markdown h3 {
  @apply mt-9;
  margin-bottom: 10px;
  font-size: 21px;
  font-weight: 650;
  letter-spacing: -0.015em;
  line-height: 1.3;
}

@media (min-width: 640px) {
  .markdown h3 {
    font-size: 22px;
  }
}

.markdown h2 + h3 {
  @apply mt-5;
}

.markdown h4 {
  @apply mt-6 mb-1;
  font-size: 17px;
  line-height: 27px;
}

.markdown h5 {
  @apply leading-tight text-sm font-semibold mb-4 mt-6;
}

.markdown h6 {
  @apply leading-tight text-sm font-semibold text-muted-strong mb-4 mt-6;
}

.markdown > :first-child {
  @apply mt-0;
}

.markdown blockquote {
  @apply border-l-4 border-line pl-4 pr-4 text-muted-strong;
}

.markdown code {
  @apply font-mono inline bg-code rounded px-1.5 py-0.5;
  font-size: 0.9em;
}

.markdown pre {
  @apply bg-code-block rounded p-4;
  font-size: 14px;
  line-height: 1.6;
  white-space: pre;
  overflow-x: auto;
}

.markdown pre code {
  @apply block bg-transparent p-0 rounded-none;
  font-size: inherit;
  line-height: inherit;
}

.markdown ul {
  @apply pl-8 list-disc;
}

.markdown ol {
  @apply pl-8 list-decimal;
}

.markdown table {
  @apply border-muted-strong;
}

.markdown th {
  @apply border py-1 px-3;
}

.markdown td {
  @apply border py-1 px-3;
}

.markdown figure {
  @apply my-8 text-center;
}

.markdown figure > figcaption {
  @apply text-sm text-muted pt-3;
}

@tailwind utilities;
